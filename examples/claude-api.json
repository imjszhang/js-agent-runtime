{
  "runId": "example-claude-api",
  "workspace": "/absolute/path/to/staged-workspace",
  "prompt": "Read the supplied instructions and create the requested draft inside this workspace.",
  "target": {
    "name": "custom-claude",
    "harness": { "adapter": "claude-code", "executable": "claude", "permission": "workspace-write" },
    "backend": { "auth": "api-key", "provider": "custom", "model": "your-model-id", "protocol": "anthropic-messages", "baseURL": "https://gateway.example", "apiKeyEnv": "CUSTOM_API_KEY", "reasoningEffort": "high" }
  },
  "timeoutMs": 600000
}
